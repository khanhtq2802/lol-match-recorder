{
	"name": "lol-match-recorder",
	"version": "0.2.0",
	"private": true,
	"description": "Records League of Legends matches from champ select to the end of the game, with the microphone",
	"author": "khanhtq1",
	"license": "MIT",
	"main": "electron/main.cjs",
	"scripts": {
		"build:helper": "node native/build.cjs",
		"prestart": "npm run build:helper",
		"start": "node electron/launch.cjs",
		"predist": "npm run build:helper",
		"dist": "electron-builder --win",
		"prerelease": "npm run build:helper",
		"release": "electron-builder --win nsis"
	},
	"dependencies": {
		"ffmpeg-static": "^5.2.0"
	},
	"devDependencies": {
		"electron": "^39.8.10",
		"electron-builder": "^25.1.8"
	},
	"build": {
		"appId": "com.lolmatchrecorder.app",
		"productName": "LOL Match Recorder",
		"directories": {
			"output": "dist"
		},
		"files": [
			"package.json",
			"electron/**/*.cjs",
			"!electron/launch.cjs",
			"static/desktop-icon.ico",
			"vendor/process-audio.exe"
		],
		"win": {
			"icon": "static/desktop-icon.ico",
			"signAndEditExecutable": false,
			"artifactName": "LOL-Match-Recorder-${version}-portable.${ext}",
			"target": [
				"dir"
			]
		},
		"asar": false,
		"nsis": {
			"oneClick": true,
			"perMachine": false,
			"runAfterFinish": true,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"shortcutName": "LOL Match Recorder",
			"installerIcon": "static/desktop-icon.ico",
			"uninstallerIcon": "static/desktop-icon.ico",
			"include": "build/installer.nsh",
			"artifactName": "LOL-Match-Recorder-Setup-${version}.${ext}"
		}
	}
}
